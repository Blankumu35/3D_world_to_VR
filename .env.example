# Copy this file to .env (same folder) and fill in what you use.
# .env is listed in .gitignore: never commit real keys.

# ---- Tripo (paid credits) ------------------------------------------
# Create a key at https://platform.tripo3d.ai (API Keys page).
TRIPO_API_KEY=
# P1 = Tripo's low-poly model. Face limit keeps models Quest-friendly.
TRIPO_MODEL=P1-20260311
TRIPO_FACE_LIMIT=5000
# TRIPO_API_BASE=https://openapi.tripo3d.ai/v3

# ---- Hugging Face: TRELLIS (free within your GPU quota) -------------
# Fine-grained token from https://huggingface.co/settings/tokens with
# "Make calls to Inference Providers" ticked.
HF_TOKEN=
# Official TRELLIS demo. If you duplicate it to your own account,
# put your copy's name here (e.g. your-name/TRELLIS).
TRELLIS_SPACE=JeffreyXiang/TRELLIS
# Used to turn a text prompt into a picture before TRELLIS.
HF_TEXT_TO_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_TEXT_TO_IMAGE_PROVIDER=auto
TRELLIS_TEXTURE_SIZE=1024
TRELLIS_MESH_SIMPLIFY=0.95

# ---- Practice mode (no AI, no cost) ----------------------------------
# 1 = offer a "Practice" maker that returns a library model. For testing.
GENERATION_PRACTICE=0

# ---- Limits -----------------------------------------------------------
GENERATION_LIMIT_PER_SESSION=10
GENERATION_DAILY_LIMIT=100
# GENERATION_TIMEOUT_MS=480000